# Supabase Storage — used for image uploads when deployed (e.g. on Vercel,
# where the filesystem is read-only). Leave unset for local dev; uploads then
# fall back to public/uploads/.
#
# 1. In Supabase: Storage → New bucket named "product-images" (set it PUBLIC)
# 2. Project Settings → API → copy the project URL and service_role key
SUPABASE_URL=https://your-project.supabase.co
# Secret key (sb_secret_...) from Project Settings → API → Secret keys.
# The legacy service_role key also works.
SUPABASE_SECRET_KEY=sb_secret_...
# Optional — defaults to "product-images"
SUPABASE_BUCKET=product-images

# Optional — admin panel password (defaults to ismail2026 on first boot)
# ADMIN_PASSWORD=your-password
