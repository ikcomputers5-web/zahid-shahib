# Supabase Storage — used for image uploads when deployed (e.g. on Vercel,
# where the filesystem is read-only). Leave unset for local dev; uploads then
# fall back to public/uploads/.
#
# 1. In Supabase: Storage → New bucket named "product-images" (set it PUBLIC)
# 2. Project Settings → API → copy the project URL and service_role key
SUPABASE_URL=https://your-project.supabase.co
# Secret key (sb_secret_...) from Project Settings → API → Secret keys.
# The legacy service_role key also works.
SUPABASE_SECRET_KEY=sb_secret_...
# Optional — defaults to "product-images"
SUPABASE_BUCKET=product-images

# Database persistence on serverless hosts (Vercel). Create a PRIVATE bucket
# named "store-db" in Supabase Storage; the app keeps the whole JSON database
# as a single "db.json" object there. With SUPABASE_URL + key set on Vercel,
# orders, admin login and admin changes work instead of the read-only preview.
# Optional — defaults to "store-db"
SUPABASE_DB_BUCKET=store-db

# Optional — secret used to sign admin session tokens (stateless, so sessions
# survive across serverless instances). If unset, the secret is derived from
# the admin password hash, which also means changing the password logs everyone out.
# SESSION_SECRET=change-me-to-a-long-random-string

# Optional — admin panel password (defaults to ismail2026 on first boot)
# ADMIN_PASSWORD=your-password

# Deploy note (Vercel): set every FIREBASE_* variable for Production, Preview
# and Development, otherwise preview deployments show the Google button as
# "not configured". Check a deployment any time at /api/health.

# ---------------------------------------------------------------------------
# Firebase Authentication (Google Sign-In)
# ---------------------------------------------------------------------------
# Client config — safe to expose to the browser. Get these from:
# Firebase Console → Project Settings → Your apps → SDK setup and configuration
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef
# Optional
FIREBASE_MEASUREMENT_ID=G-XXXXXXXX

# Server-side verification (required for secure token checks in production):
# Option A — paste the entire service-account JSON (single line):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
# Option B — three separate vars:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Option C — path to downloaded service-account file:
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
# or set GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Local development only: accept unverified Firebase tokens (NEVER in production).
# FIREBASE_ALLOW_INSECURE_DECODE=1

# Optional — restrict which Google accounts can access /admin.
# Comma-separated emails. Leave empty to allow any authenticated Google user (demo mode).
# ADMIN_EMAILS=admin@ismailelegance.pk,owner@gmail.com
# FIREBASE_ADMIN_EMAILS is an alias for the same
