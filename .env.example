# Supabase Storage — used for image uploads when deployed (e.g. on Vercel,
# where the filesystem is read-only). Leave unset for local dev; uploads then
# fall back to public/uploads/.
#
# 1. In Supabase: Storage → New bucket named "product-images" (set it PUBLIC)
# 2. Project Settings → API → copy the project URL and service_role key
SUPABASE_URL=https://your-project.supabase.co
# Secret key (sb_secret_...) from Project Settings → API → Secret keys.
# The legacy service_role key also works.
SUPABASE_SECRET_KEY=sb_secret_...
# Optional — defaults to "product-images"
SUPABASE_BUCKET=product-images

# Database persistence on serverless hosts (Vercel). Create a PRIVATE bucket
# named "store-db" in Supabase Storage; the app keeps the whole JSON database
# as a single "db.json" object there. With SUPABASE_URL + key set on Vercel,
# orders, admin login and admin changes work instead of the read-only preview.
# Optional — defaults to "store-db"
SUPABASE_DB_BUCKET=store-db

# Optional — secret used to sign admin session tokens (stateless, so sessions
# survive across serverless instances). If unset, the secret is derived from
# the admin password hash, which also means changing the password logs everyone out.
# SESSION_SECRET=change-me-to-a-long-random-string

# Optional — admin panel password (defaults to ismail2026 on first boot)
# ADMIN_PASSWORD=your-password
